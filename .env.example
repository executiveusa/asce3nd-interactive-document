# Required RSVP runtime configuration. Never commit real values.
SUPABASE_RPC=https://your-supabase-host/rest/v1/rpc/
SUPABASE_ANON=replace_with_publishable_or_anon_key

# Comma-separated exact browser origins allowed to submit RSVP requests.
RSVP_PUBLIC_ORIGIN=https://asc3nd-frontend.vercel.app,https://asc3nd-interactive-document.vercel.app

# Public base used to construct verification and cancellation links.
RSVP_PUBLIC_BASE_URL=https://asc3nd-interactive-document.vercel.app

# At least 32 random bytes. Used only to HMAC client IPs before durable rate limiting.
RSVP_RATE_LIMIT_SECRET=replace_with_long_random_secret

# Optional notification settings.
RSVP_OPS_EMAIL=
